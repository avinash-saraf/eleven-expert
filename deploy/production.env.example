# Copy to production.env on the Ubuntu server. These are placeholders, not credentials.
# Use `openssl rand -hex 32` for the database password (hex needs no URL escaping).
POSTGRES_USER=eleven_expert
POSTGRES_DB=eleven_expert
POSTGRES_PASSWORD=replace_with_a_random_hex_password

BACKEND_PORT=3300
FRONTEND_PORT=8080
VITE_API_BASE_URL=https://api-meets.sellmate.kz
CORS_ORIGINS=https://meets.sellmate.kz

# Copy these settings from your working backend configuration.
SESSION_API_KEY=replace_with_your_existing_session_key
RECALL_REGION=us-east-1
RECALL_API_KEY=replace_with_your_recall_key
GOOGLE_LOGIN_GROUP_ID=replace_with_your_login_group_id
RECALL_PUBLIC_WEBSOCKET_URL=wss://api-meets.sellmate.kz/recall/media/
RECALL_WORKSPACE_VERIFICATION_SECRET=
RECALL_SVIX_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=replace_with_your_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-5-5
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_key
ELEVENLABS_LEARN_AGENT_ID=replace_with_agent_id_from_npm_run_agents_create
ELEVENLABS_TEACH_AGENT_ID=replace_with_agent_id_from_npm_run_agents_create
ELEVENLABS_AGENT_LLM=claude-sonnet-4-5
ELEVENLABS_VOICE_ID=

# Remotely managed Cloudflare Tunnel token for the server (not a Cloudflare API key).
CLOUDFLARE_TUNNEL_TOKEN=
